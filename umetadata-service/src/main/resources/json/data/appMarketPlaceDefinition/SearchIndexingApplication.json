{
  "name": "SearchIndexingApplication",
  "displayName": "Search Indexing",
  "description": "UMetadata connects with Elastic/Open Search to provide search feature for Data Assets. This application provides additional features related to ES/OS.",
  "features": "Sync UMetadata and Elastic Search and Recreate Indexes.",
  "appType": "internal",
  "appScreenshots": ["SearchIndexPic1"],
  "developer": "Collate Inc.",
  "developerUrl": "https://www.wondersgroup.com",
  "privacyPolicyUrl": "https://www.wondersgroup.com",
  "supportEmail": "support@wondersgroup.com",
  "scheduleType": "ScheduledOrManual",
  "permission": "All",
  "className": "org.umetadata.service.apps.bundles.searchIndex.SearchIndexApp",
  "runtime": {
    "enabled": true
  },
  "supportsInterrupt": true,
  "appConfiguration": {
    "entities": [
      "all"
    ],
    "recreateIndex": false,
    "batchSize": "100",
    "payLoadSize": 104857600,
    "producerThreads": 1,
    "queueSize": 100,
    "consumerThreads": 1,
    "maxConcurrentRequests": 100,
    "maxRetries": 3,
    "initialBackoff": 1000,
    "maxBackoff": 10000,
    "searchIndexMappingLanguage": "EN"
  }
}
